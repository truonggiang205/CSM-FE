# ==============================================================================
# CSM-FE - CẤU HÌNH MÔI TRƯỜNG MẪU (VITE)
# CẢNH BÁO BẢO MẬT:
# Mọi biến có tiền tố VITE_* đều được nhúng công khai vào bundle trình duyệt.
# TUYỆT ĐỐI KHÔNG đặt secret, API key bí mật hay mật khẩu vào biến VITE_*.
# ==============================================================================

# CÁCH DÙNG: sao chép file này thành .env ở thư mục gốc CSM-FE rồi sửa nếu cần
#   PowerShell: Copy-Item .env.example .env
#   macOS/Linux/Git Bash: cp .env.example .env
# Vite chỉ đọc .env khi khởi động, nên sửa xong phải chạy lại `npm run dev`.
# Khi chạy bằng Docker Compose của CSM-BE, FE dùng giá trị mặc định nên không cần .env.

# URL API Gateway công khai mà trình duyệt gọi tới (Không bắt buộc, mặc định http://localhost:8000/api/v1)
VITE_API_URL="http://localhost:8000/api/v1"

# ------------------------------------------------------------------------------
# BIẾN DÀNH CHO KIỂM THỬ PLAYWRIGHT / E2E (Chỉ dùng ở môi trường test, KHÔNG dùng VITE_*)
# Playwright KHÔNG tự đọc file .env: hãy đặt các biến này trong terminal trước khi chạy
# `npx playwright test`. Mật khẩu phải khớp với .env của CSM-BE lúc chạy `npm run seed`.
# Thứ tự ưu tiên: E2E_<ROLE>_PASSWORD > SEED_<ROLE>_PASSWORD > SEED_PASSWORD
# ------------------------------------------------------------------------------
# E2E_BASE_URL="http://localhost:3000"
# E2E_GATEWAY_URL="http://localhost:8000/api/v1"
# SEED_PASSWORD="CHANGE_ME_SEED_PASSWORD_DEMO"
# SEED_ADMIN_PASSWORD="Admin@123456"
# SEED_MANAGER_PASSWORD="Manager@123456"
# SEED_CUSTOMER_PASSWORD="Customer@123456"
